{
	"name" : "cusodede/yii2-permissions",
	"description" : "Permissions support module for Yii2",
	"minimum-stability" : "dev",
	"prefer-stable" : true,
	"license" : "LGPL-3.0-or-later",
	"authors" : [
		{
			"name" : "Pavel Dubrovsky",
			"email" : "antikillerxxl@gmail.com"
		}
	],
	"require" : {
		"php" : ">=8.3",
		"pozitronik/yii2-traits" : "^1.0.0",
		"pozitronik/yii2-relations" : "^1.0.0",
		"pozitronik/yii2-badgewidget" : "^2.0.0",
		"pozitronik/yii2-helpers" : "^1.1.2",
		"cusodede/yii2-default-controller" : "^1.0.15",
		"yiisoft/yii2-bootstrap4" : "~2.0.10",
		"kartik-v/yii2-widget-select2" : "^2.2.3",
		"kartik-v/yii2-editable" : "^1.8.0",
		"cusodede/yii2-multi-select-widget" : "dev-master",
		"pozitronik/yii2-grid-helper-asset" : "^1.0.0",
		"kartik-v/yii2-widget-depdrop" : "@dev"
	},
	"require-dev" : {
		"yiisoft/yii2" : "dev-master",
		"yiisoft/yii2-gii" : "dev-master",
		"phpunit/phpunit" : "^12.0.0",
		"codeception/codeception" : "^5.0.0",
		"codeception/module-asserts" : "^3.0.0",
		"codeception/module-phpbrowser" : "^3.0.0",
		"codeception/module-yii2" : "^v2.0.0",
		"codeception/module-db" : "^3.0.0",
		"codeception/module-filesystem" : "^3.0.0",
		"codeception/module-rest" : "^3.0.0",
		"vlucas/phpdotenv" : "^5.4.1",
		"codeception/module-cli" : "*"
	},
	"autoload" : {
		"psr-4" : {
			"cusodede\\permissions\\" : "src"
		}
	},
	"config" : {
		"process-timeout" : 1800,
		"fxp-asset" : {
			"enabled" : false
		},
		"allow-plugins" : {
			"yiisoft/yii2-composer" : true
		}
	},
	"repositories" : [
		{
			"type" : "composer",
			"url" : "https://asset-packagist.org"
		}
	]
}
